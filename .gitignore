# =====================================================================
# KAIZEN INTELLIGENCE PLATFORM — .gitignore
# Schneider Electric EcoStruxure & Industrial AI Platform
# =====================================================================

# ── Operating System Files ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── IDEs and Editors ────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.rej
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# ── Python & Environments ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
virtualenv/
pip-log.txt
pip-delete-this-directory.txt

# Python packaging & build artifacts
# (Use anchored or specific paths so frontend/src/lib is never ignored)
/build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ── Node.js & Frontend (React / Vite / TypeScript) ──────────────────
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
out/
.next/
.nuxt/
.turbo/
.cache
.npm

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Linters & Build cache
.eslintcache
.stylelintcache
*.tsbuildinfo

# Ensure source library folders are NEVER ignored
!**/src/lib/
!**/src/lib/**
!frontend/src/lib/
!frontend/src/lib/**

# ── ML Models, Weights & Datasets ───────────────────────────────────
*.h5
*.pb
*.onnx
*.pkl
*.joblib
*.pt
*.pth
*.safetensors
runs/
wandb/
.tensorboard/

# ── Environment & Secrets (Never commit credentials) ───────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Allow example environment templates
!.env.example
!.env*.example

# ── Databases & Persistent Local Storage ────────────────────────────
*.log
*.sqlite
*.sqlite3
*.db
postgres_data/
timescale_data/
redis_data/
kafka_data/
zookeeper_data/
grafana_data/
prometheus_data/

# ── Temporary & Scratch Files ───────────────────────────────────────
temp.txt
*.tmp
