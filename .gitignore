# =====================================================================
# KAIZEN INTELLIGENCE PLATFORM — .gitignore
# Schneider Electric EcoStruxure & Industrial AI Platform
# =====================================================================

# ── Operating System Files ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ── IDEs, Editors & AI Agent Tooling ────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.rej
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.user
*.userosscache
*.sln.docstates
*.code-workspace

# AI Agent & Assistant Artifacts
.gemini/
.antigravity/
.system_generated/
.cursor/
.windsurf/

# ── Python & Virtual Environments ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
virtualenv/
pip-log.txt
pip-delete-this-directory.txt

# Python packaging & build artifacts
# (Use anchored or specific paths so frontend/src/lib is never ignored)
/build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing, Coverage & Type Checking
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Jupyter Notebooks & Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# ── Node.js & Frontend (React / Vite / TypeScript) ──────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
out/
.next/
.nuxt/
.turbo/
.cache/
.npm/
.pnpm-store/
.vite/
frontend/.vite/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Linters, Type Check & Build cache
.eslintcache
.stylelintcache
*.tsbuildinfo

# Ensure source library folders are NEVER ignored
!**/src/lib/
!**/src/lib/**
!frontend/src/lib/
!frontend/src/lib/**

# ── Machine Learning Models, Checkpoints & Datasets ─────────────────
*.h5
*.pb
*.onnx
*.pkl
*.joblib
*.pt
*.pth
*.safetensors
*.bin
*.ckpt
*.tflite
runs/
wandb/
.tensorboard/
lightning_logs/
mlruns/
ml_models/
ml-service/models/*
!ml-service/models/.gitkeep

# ── Environment & Secrets (Never commit credentials) ───────────────
.env
.env.*
.env*.local
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Allow example environment templates
!.env.example
!.env*.example
!.env.template

# ── Databases, Docker Volumes & Persistent Local Storage ────────────
*.sqlite
*.sqlite3
*.db
*.rdb
postgres_data/
timescale_data/
redis_data/
kafka_data/
zookeeper_data/
zookeeper_logs/
minio_data/
grafana_data/
prometheus_data/

# ── Application Logs & Service Dumps ────────────────────────────────
*.log
logs/
backend/logs/
backend_logs/
ml-service/logs/
simulator/logs/

# ── Temporary & Scratch Files ───────────────────────────────────────
temp.txt
backend/temp.txt
*.tmp
*.temp
scratch/
tmp/
