# ─────────────────────────────────────────────
#  KAIZEN — Change for Better
#  Environment Configuration Template
#  Copy this file to .env and edit values.
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=changeme-use-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Database (PostgreSQL + TimescaleDB) ───────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kaizen
POSTGRES_USER=kaizen
POSTGRES_PASSWORD=kaizen_secret
DATABASE_URL=postgresql+asyncpg://kaizen:kaizen_secret@postgres:5432/kaizen
DATABASE_URL_SYNC=postgresql://kaizen:kaizen_secret@postgres:5432/kaizen

# ── Redis ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Kafka ─────────────────────────────────────
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=kaizen-backend

# ── MinIO ─────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MODELS=kaizen-models
MINIO_BUCKET_REPORTS=kaizen-reports

# ── ML Service ────────────────────────────────
ML_SERVICE_URL=http://ml-service:8001
MODEL_PATH=/app/models

# ── Simulator ─────────────────────────────────
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_SCENARIO=normal
SIMULATOR_PUBLISH_TO=kafka

# ── Frontend ──────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_TITLE=KAIZEN — Change for Better

# ── Monitoring ────────────────────────────────
PROMETHEUS_ENABLED=true

# ── Energy Cost Config ────────────────────────
ENERGY_COST_PER_KWH=7.5
FUEL_COST_PER_GJ=850.0
CO2_EMISSION_FACTOR_GRID=0.82
CO2_EMISSION_FACTOR_COAL=95.0
