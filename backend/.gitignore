# Backend (FastAPI + Python) — .gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.*
*.env
!.env.example
!.env.template

# Testing, Coverage & Linters
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Logs & Temporary files
logs/*
!logs/.gitkeep
*.log
temp.txt
*.tmp
*.temp

# SQLite databases & locks
*.sqlite3
*.sqlite
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
